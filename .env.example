# Copy this file to `.env` and fill in credentials/config as needed.
# experiments/run_benchmark.py and experiments/run_training.py load_dotenv() this.

# --- LLM extraction models (bench_extract.models.base.OpenAIChatModel) ---
# Any OpenAI-compatible chat completions endpoint: hosted API, a local vLLM
# server, Ollama, etc. vLLM ignores the key, but the OpenAI SDK requires a
# non-empty string, so this must be set to *something* even for a local model.
BENCH_EXTRACT_LLM_API_KEY=local

# --- Per-model endpoints for models served in their own job ---
# One variable per `base_url_env` declared in a experiments/model-configs/*.yaml
# (every current model -- comparing routing/cascade/scheduling strategies needs
# several models reachable at once, so each is served by its own
# `bash experiments/submit.sh serve <model-key>` job, not started inside the
# benchmark/training job itself). Usually NOT needed even so: serve_model.py
# registers its endpoint in experiments/.endpoints.json automatically, and
# experiments/serving.py's endpoint_for() finds it there first (works as long as
# the serve job's node and the benchmark/training job's node share a filesystem,
# true by default on this project's cluster allocation). Only set this by hand as
# a manual override or fallback (a non-shared filesystem, or a server started
# outside serve_model.py).
BENCH_EXTRACT_GPT_OSS_120B_BASE_URL=

# --- vLLM invocation override (experiments/serving.py) ---
# Only needed if `vllm serve` isn't directly on PATH (e.g. a Singularity/
# container wrapper). Leave unset to use a bare `vllm serve`.
BENCH_EXTRACT_VLLM_COMMAND=
